generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  role         String        @default("user")
  refreshToken String?
  createdAt    DateTime      @default(now())
  applications Application[]
}

model Job {
  id           String        @id @default(cuid())
  source       String        @default("remotive")
  externalId   String
  title        String
  company      String
  location     String
  description  String
  url          String        @unique
  salary       String?
  postedAt     DateTime
  createdAt    DateTime      @default(now())
  applications Application[]

  @@unique([source, externalId])
  @@index([postedAt(sort: Desc), id(sort: Desc)], map: "Job_postedAt_id_desc_idx")
  @@index([postedAt(sort: Asc), id(sort: Asc)], map: "Job_postedAt_id_asc_idx")
  @@index([location])
  @@index([company])
}

model Application {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  status    String   @default("applied")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  job  Job  @relation(fields: [jobId], references: [id])

  @@unique([userId, jobId])
}
